# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` (which is gitignored) and fill in real values.
# Use KEY=value with no spaces around `=`.
# ──────────────────────────────────────────────────────────────────────────────

# ── Task Master AI (CLI/MCP) — ALL OPTIONAL with this template.
# .taskmaster/config.json uses the `claude-code` provider, which reuses your
# Claude Code session — no API key needed. Only add keys here if you switch to
# API-based models or want `--research` mode (Perplexity recommended for that).
#ANTHROPIC_API_KEY="sk-ant-api03-..."
#PERPLEXITY_API_KEY="pplx-..."
#OPENAI_API_KEY="sk-proj-..."
#GOOGLE_API_KEY="..."
#OPENROUTER_API_KEY="..."

# ── Project variables

# PostgreSQL control-plane database. The default matches the dev container's
# local server (created by .devcontainer/post-start.sh). Per-customer databases
# are created on the same server by the app.
DATABASE_URL="postgres://robin:robin@localhost:5432/robin"

# Public base URL of the app — used for OAuth redirects and Recall.ai webhooks.
# In dev: the forwarded address of port 3000 with visibility set to Public.
APP_URL="http://localhost:3000"

# Secret used to sign login session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# v1 is single-user: sign-up closes once the first account exists. Set to "true"
# to let further accounts be created.
#ALLOW_SIGNUP="true"

# Anthropic API key for Robin's agents — https://console.anthropic.com → API keys.
# (Separate from the Task Master key above; this one is used by the app itself.)
#ROBIN_ANTHROPIC_API_KEY="sk-ant-api03-..."

# Recall.ai meeting bot — Recall.ai dashboard → API keys / webhooks.
#RECALL_API_KEY="..."
#RECALL_WEBHOOK_SECRET="whsec_..."
# Region of the Recall.ai workspace: us-west-2 (pay-as-you-go), us-east-1,
# eu-central-1 or ap-northeast-1.
#RECALL_REGION="us-west-2"
# Transcription: "meeting_captions" (default; the meeting platform's own
# captions, no extra charge, captions must be enabled in the meeting) or
# "recallai_streaming" (Recall.ai's paid transcription).
#RECALL_TRANSCRIPT_PROVIDER="meeting_captions"
# MEETING_BOT_PROVIDER="fake" replaces Recall.ai with a stand-in that joins
# nothing and costs nothing, for trying the live call screen locally
# (see scripts/simulate-call.mjs).
#MEETING_BOT_PROVIDER="fake"

# Google OAuth (Gmail, Drive, Calendar) — Google Cloud Console → APIs & Services
# → Credentials → OAuth client ID (Web application).
# Authorised redirect URI: <APP_URL>/api/integrations/google/callback
#GOOGLE_CLIENT_ID="..."
#GOOGLE_CLIENT_SECRET="..."

# Atlassian OAuth 2.0 (Confluence, Jira) — developer.atlassian.com → Developer
# console → your app → Settings.
# Callback URL: <APP_URL>/api/integrations/atlassian/callback
# Scopes: read:me, read:confluence-space.summary, read:confluence-content.all,
# read:jira-work (offline_access is requested automatically).
# For publishing to Confluence also add: write:confluence-content, write:jira-work
#ATLASSIAN_CLIENT_ID="..."
#ATLASSIAN_CLIENT_SECRET="..."

# Key used to encrypt stored OAuth tokens. Generate with: openssl rand -base64 32
#TOKEN_ENCRYPTION_KEY="..."

# Embeddings run locally (no key). EMBEDDINGS_PROVIDER="local-hash" selects a
# meaning-less test stand-in instead of the real model.

# More variables (transcription provider) will
# be added when those PRD open questions are settled.
