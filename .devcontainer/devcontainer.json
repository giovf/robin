{
  "name": "Robin",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },

  "remoteUser": "vscode",

  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // Persistent named volumes keep state across container rebuilds.
  // All are PER-PROJECT (prefixed with the workspace folder name), so two
  // projects created from this template never share state:
  // - claude-config:  ~/.claude (auth + session history + custom commands).
  //                   You run /login once per project; it survives rebuilds.
  // - node-modules:   keeps installs fast, off slow bind-mounts
  // - shell-history:  preserves zsh history
  "mounts": [
    "source=${localWorkspaceFolderBasename}-claude-config,target=/home/vscode/.claude,type=volume",
    "source=${localWorkspaceFolderBasename}-node-modules,target=${containerWorkspaceFolder}/node_modules,type=volume",
    "source=${localWorkspaceFolderBasename}-shell-history,target=/commandhistory,type=volume",
    // - pgdata: PostgreSQL data (control-plane DB + one DB per customer)
    "source=${localWorkspaceFolderBasename}-pgdata,target=/var/lib/postgresql,type=volume"
  ],

  // 3000: Next.js dev server. For Recall.ai webhooks, set this port's
  // visibility to Public in the Ports panel. 5432: local PostgreSQL.
  "forwardPorts": [3000, 5432],
  "portsAttributes": {
    "3000": { "label": "Robin (Next.js)", "onAutoForward": "notify" },
    "5432": { "label": "PostgreSQL", "onAutoForward": "silent" }
  },

  // Runs once after the container is first created (and after every rebuild).
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  // Runs on every container start: starts PostgreSQL and ensures the dev
  // role, `robin` database and pgvector extension exist.
  "postStartCommand": "bash .devcontainer/post-start.sh",

  "customizations": {
    "vscode": {
      // Base set, plus stack-specific extensions at the end.
      "extensions": [
        "anthropic.claude-code",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "editorconfig.editorconfig",
        "eamodio.gitlens",
        "github.vscode-pull-request-github",
        "ms-azuretools.vscode-docker",
        "bradlc.vscode-tailwindcss"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  }
}
